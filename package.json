{
  "name": "table-js",
  "version": "10.0.0-esm.0",
  "scripts": {
    "all": "run-s lint build test",
    "dev": "karma start karma.conf.cjs --no-single-run --auto-watch --log-level debug",
    "lint": "eslint .",
    "test": "karma start karma.conf.cjs",
    "build": "del-cli lib && babel -s -d lib src",
    "auto-build": "babel -s -d lib src --watch",
    "prepublishOnly": "run-s build"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./lib/core": "./lib/core/index.js",
    "./lib/render": "./lib/render/index.js",
    "./lib/components": "./lib/components/index.js",
    "./lib/model": "./lib/model/index.js",
    "./lib/features/context-menu": "./lib/features/context-menu/index.js",
    "./lib/features/drag-and-drop": "./lib/features/drag-and-drop/index.js",
    "./lib/features/editor-actions": "./lib/features/editor-actions/index.js",
    "./lib/features/interaction-events": "./lib/features/interaction-events/index.js",
    "./lib/features/modeling": "./lib/features/modeling/index.js",
    "./lib/features/rules": "./lib/features/rules/index.js",
    "./lib/features/selection": "./lib/features/selection/index.js",
    "./lib/*": "./lib/*",
    "./test/*": "./test/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/table-js"
  },
  "engines": {
    "node": "*"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^10.1.1",
    "babel-plugin-inferno": "^5.1.0",
    "chai": "^6.0.0",
    "del-cli": "^7.0.0",
    "diagram-js": "^16.0.0-esm.2",
    "eslint": "^9.39.4",
    "eslint-plugin-bpmn-io": "^2.2.0",
    "inferno": "^5.6.3",
    "inferno-test-utils": "^5.6.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-webpack": "^5.0.1",
    "mocha": "^11.7.6",
    "mocha-test-container-support": "^0.2.0",
    "npm-run-all2": "^9.0.1",
    "puppeteer": "^25.1.0",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.0",
    "webpack": "^5.107.2"
  },
  "dependencies": {
    "didi": "^11.0.0",
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0",
    "selection-ranges": "^4.1.1"
  },
  "files": [
    "lib"
  ],
  "peerDependencies": {
    "diagram-js": "^16.0.0-esm.2",
    "inferno": "^5.0.5"
  }
}
